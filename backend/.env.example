# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
# Local: mongodb://127.0.0.1:27017/domain_dns_tool
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/domain_dns_tool?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/domain_dns_tool

# Security / CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
